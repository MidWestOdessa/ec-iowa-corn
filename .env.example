# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required for the NOAA / GDD pipeline -------------------------------
# Free token, email-validated, issued instantly:
#   https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=

# --- Required only outside the owner's machine --------------------------
# Absolute path to the canonical workbook. The workbook is the deliverable
# and is NOT in the repo (it lives in OneDrive; .gitignore excludes
# workbooks/*.xlsx), so a fresh clone or cloud sandbox must point at its own
# copy. Unset, the code falls back to the owner's OneDrive path.
#   PowerShell : $env:EC_IOWA_WORKBOOK = "D:\data\Corn Progress ... .xlsx"
#   bash       : export EC_IOWA_WORKBOOK=/data/corn.xlsx
EC_IOWA_WORKBOOK=

# --- Optional -----------------------------------------------------------
# Unused today. The weekly condition lookup goes through USDA ESMIS over
# plain HTTP and needs no key. A QuickStats key would allow richer queries:
#   https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# Password gate for the deployed Streamlit dashboard. Set this in Streamlit
# Cloud under Settings > Secrets, not here. If unset, the dashboard is open.
# APP_PASSWORD=
